{
  "compilerOptions": {
    "target": "ES2020",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "role.*": [
        "./src/role/*"
      ],
      "utils.*": [
        "./src/utils/*"
      ],
      "manager.*": [
        "./src/manager/*"
      ]
    },
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}